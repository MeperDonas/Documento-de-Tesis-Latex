\subsection{Notas sobre el Presupuesto}

\textbf{Inversiones (\$50,000):}

\begin{itemize}
	\item Todas las herramientas de desarrollo son gratuitas (código abierto)
	\item Servicios de despliegue en planes gratuitos suficientes
	\item Dominio opcional, puede usarse subdominio gratuito
\end{itemize}

\textbf{Gastos de Desarrollo (\$270,000):}

\begin{itemize}
	\item Internet necesario para desarrollo y consultas
	\item Electricidad por uso del equipo de cómputo
\end{itemize}

\textbf{Mano de Obra (\$4,920,000):}

\begin{itemize}
	\item Valor estimado del tiempo invertido por el desarrollador
	\item Honorarios del director de tesis por asesorías
\end{itemize}

\textbf{Ahorro respecto a soluciones comerciales:}

\begin{itemize}
	\item Licencias de software (IDE, herramientas): \textasciitilde\$2,000,000
	\item Hosting/servidores comerciales: \textasciitilde\$600,000/año
	\item \textbf{Total ahorrado: \textasciitilde\$2,600,000}
\end{itemize}

